# ============================================
data/raw/
data/processed/
data/features/samples_full.parquet
data/features/*_test*
data/features/*_deploy*

# ============================================
# INTERMEDIATE CHECKPOINTS (Keep only stage3_best.pt)
# ============================================
outputs/checkpoints/*.pt
!outputs/checkpoints/stage3_best.pt

